    text: Horizontal bars + percent stacks
    fontFamily: Arial
    fontSize: 30
    color: '#172554'
- elementId: horizontal
  elementType: chart
  bounds:
  - 40
  - 110
  - 420
  - 350
  title:
    text: Departments
    fontSize: 20
    fontFamily: Arial
  fontFamily: Arial
